PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials:
# Example: mongodb+srv://myuser:mypassword@cluster0.abcde.mongodb.net/taskmanager?retryWrites=true&w=majority
# Or local MongoDB: mongodb://127.0.0.1:27017/taskmanager
MONGODB_URI=mongodb://127.0.0.1:27017/taskmanager

# JWT Authentication
JWT_SECRET=taskmanager_super_secure_jwt_secret_key_2026_x89a1b2c3d4e5f
JWT_EXPIRES_IN=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

